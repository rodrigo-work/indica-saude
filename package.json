{
  "name": "indica-saude",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "preinstall": "npx only-allow pnpm",
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "biome check",
    "lint:fix": "biome check --write --unsafe",
    "format": "turbo format",
    "test": "turbo test",
    "clean": "turbo clean && git clean -xdf .turbo .cache .next .vercel node_modules",
    "analyze": "turbo analyze",
    "bump-ui": "npx shadcn@latest add --all --overwrite -c packages/ui",
    "bump-deps": "npx npm-check-updates --deep -u -x react-day-picker",
    "translate": "turbo translate",
    "boundaries": "turbo boundaries",
    "check-types": "turbo check-types",
    "migrate": "cd packages/database && npx prisma format && npx prisma generate && npx prisma db push",
    "prepare": "husky"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.3.2",
    "@commitlint/cli": "^20.1.0",
    "@commitlint/config-conventional": "^20.0.0",
    "@workspace/typescript-config": "workspace:*",
    "husky": "^9.1.7",
    "lint-staged": "16.2.6",
    "turbo": "^2.6.0",
    "typescript": "^5.9.3",
    "ultracite": "^6.3.4"
  },
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22.x",
    "pnpm": ">=10.x"
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js,jsx,json,css,md}": [
      "biome check --write --unsafe"
    ],
    "apps/api/**/*.{ts,js,json}": [
      "biome check --write --unsafe"
    ]
  },
  "dependencies": {
    "@clack/prompts": "0.11.0",
    "commander": "14.0.2"
  }
}