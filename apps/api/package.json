{
  "name": "api",
  "description": "Api of Indica Saúde",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsup src/index.ts --watch --onSuccess \"node dist/index.js\" ",
    "build": "tsup",
    "start": "node dist/index.js",
    "lint": "eslint src/ --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest --watch",
    "clean": "git clean -xdf .cache .turbo .next dist node_modules",
    "check-types": "tsc --noEmit --emitDeclarationOnly false"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.914.0",
    "@t3-oss/env-core": "^0.13.8",
    "@workspace/database": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "google-auth-library": "10.5.0",
    "helmet": "^8.1.0",
    "jose": "^6.1.0",
    "morgan": "^1.10.1",
    "swagger-autogen": "^2.23.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/morgan": "^1.9.10",
    "@types/node": "^20.19.22",
    "@types/supertest": "^6.0.3",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.1.4",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.2"
  }
}
