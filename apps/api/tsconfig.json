{
  "compilerOptions": {
    "target": "ES2020",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "types": ["node"],
    "skipLibCheck": true,
    "paths": {
      "@workspace/*": ["../../packages/*"]
    }
  },
  "include": ["src", "src/**/*.d.ts"],
  "exclude": ["node_modules", "dist", "samples"]
}
