# Arquivo .dockerignore para o projeto
# Ignorar dependências e artefatos de build
node_modules
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
dist/
build/
*.egg-info/
*.egg
pip-wheel-metadata/

# Ignorar ambiente virtual / variáveis sensíveis
.env
.env.*
.venv/
venv/
env/
venv.bak/

